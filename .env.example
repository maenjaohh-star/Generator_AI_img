# =========================
# APP
# =========================

NODE_ENV=development

APP_NAME=AI Asset Generator

APP_PORT=5000

FRONTEND_URL=http://localhost:5173

CORS_ORIGIN=http://localhost:5173

# =========================
# DATABASE
# =========================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_asset_generator

POSTGRES_DB=ai_asset_generator

POSTGRES_USER=postgres

POSTGRES_PASSWORD=postgres

# =========================
# JWT
# =========================

JWT_SECRET=CHANGE_THIS_SECRET

JWT_EXPIRES=7d

# =========================
# STORAGE
# =========================

STORAGE_DRIVER=local

UPLOAD_PATH=storage/uploads

GENERATED_PATH=storage/generated

THUMBNAIL_PATH=storage/thumbnails

EXPORT_PATH=storage/exports

# =========================
# AI
# =========================

OPENAI_API_KEY=

GEMINI_API_KEY=

HUGGINGFACE_API_KEY=

# =========================
# OAUTH
# =========================

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=